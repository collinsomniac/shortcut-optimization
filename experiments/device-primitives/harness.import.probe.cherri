#define name harness.import.probe
#define color blue
#define glyph checkmark
#define inputs text
#define outputs text
#define version 27

#include 'actions/web'

comment('Minimal device primitive probe. Input is a callback URL.')
comment('When executed after import, POST success to the callback and output a deterministic marker.')

@callback = "{ShortcutInput}"
@result = "harness-import-probe-executed"

if @callback {
    jsonRequest(@callback, "POST", {
        "state": "success",
        "result": "{@result}"
    })
}

output("{@result}")
