#define name harness.import.probe.v3
#define color blue
#define glyph wrench
#define inputs text
#define outputs text
#define version 27

#include 'actions/web'

comment('Device primitive probe v3: proves registration + execution without x-callback or clipboard.')
comment('Writes a deterministic marker into the a-Shell App Group via its headless Execute Command intent.')
comment('Optional Shortcut input is a callback URL for a second independent proof channel.')

@callback = "{ShortcutInput}"
@result = "harness-import-probe-v3-executed"

const shellProof = rawAction("AsheKube.app.a-Shell.ExecuteCommandIntent", {
    "ShowWhenRun": false,
    "command": "echo harness-import-probe-v3-executed > harness.import.probe.v3.proof",
    "keepGoing": false,
    "openWindow": "close"
})

if @callback {
    jsonRequest(@callback, "POST", {
        "state": "success",
        "result": "{@result}"
    })
}

output("{@result}")
