#define name harness.import.probe.v2
#define color blue
#define glyph wrench
#define inputs text
#define outputs text
#define version 27

#include 'actions/web'
#include 'actions/sharing'

comment('Minimal device primitive probe. Input is a callback URL.')
comment('When executed after import, POST success to the callback and output a deterministic marker.')

@callback = "{ShortcutInput}"
@result = "harness-import-probe-v2-executed"

setClipboard(@result, true)

if @callback {
    jsonRequest(@callback, "POST", {
        "state": "success",
        "result": "{@result}"
    })
}

output("{@result}")
