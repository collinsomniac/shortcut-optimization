#define name harness.import.probe.v4
#define color blue
#define glyph wrench
#define inputs text
#define outputs text
#define version 27

#include 'actions/web'

comment('Device primitive probe v4: lock-safe registration + execution proof.')
comment('No a-Shell, no app opening, no UI. Shortcut input is an optional HTTPS callback URL.')

@callback = "{ShortcutInput}"
@result = "harness-import-probe-v4-executed"

if @callback {
    jsonRequest(@callback, "POST", {
        "state": "success",
        "result": "{@result}"
    })
}

output("{@result}")
