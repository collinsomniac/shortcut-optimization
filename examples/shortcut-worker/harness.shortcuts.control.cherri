#define name shortcuts.control
#define color blue
#define glyph wrench
#define inputs text
#define outputs text
#define version 27

#include 'actions/shortcuts'
#include 'actions/web'
#include 'actions/text'

comment('shortcuts.control v0.5 — resident native Shortcuts library authority.')
comment('Pure Shortcuts: no a-Shell, no long-running worker process, no UI automation.')
comment('Input is JSON. If callback is supplied, the controller POSTs the actual device result to the harness.')
comment('bootstrap moves this Shortcut beside probe.echo so the existing folder-driven dispatcher can discover it.')

const request = getDictionary(ShortcutInput)

@op = "{request['op']}"

comment('First-run bootstrap: an ordinary no-input run self-registers into the live tools folder.')
if !@op {
    @op = "bootstrap"
}
@name = "{request['name']}"
@newName = "{request['new_name']}"
@runInput = "{request['input']}"
@confirm = "{request['confirm']}"
@folder = "{request['folder']}"
@callback = "{request['callback']}"

@handled = "false"
@state = "success"
@result = ""

if @op == "ping" {
    @handled = "true"
    @result = "ok ping shortcuts.control 0.5"
}

if @op == "capabilities" {
    @handled = "true"
    @result = "bootstrap\nping\ncapabilities\nlist\nget\nrun\ncreate\nopen\ncreate_folder\nmove_new_folder\nrename\ndelete\ncreate_link\nreceipt:http"
}

comment('Bootstrap: use probe.echo as a known resident member of the live tools folder.')
if @op == "bootstrap" {
    @handled = "true"
    @foundSelf = "false"
    @foundAnchor = "false"

    const bootstrapEntities = getShortcuts()

    for bootstrapEntity in bootstrapEntities {
        const bootstrapName = getShortcutDetail(@bootstrapEntity, "Name")
        @bootstrapNameText = "{bootstrapName}"

        if @bootstrapNameText == "shortcuts.control" {
            @foundSelf = "true"
            @selfEntity = @bootstrapEntity
        }

        if @bootstrapNameText == "probe.echo" {
            @foundAnchor = "true"
            @anchorEntity = @bootstrapEntity
        }
    }

    if @foundSelf == "false" {
        @state = "error"
        @result = "error bootstrap_self_not_found"
    } else {
        if @foundAnchor == "false" {
            @state = "error"
            @result = "error bootstrap_anchor_not_found"
        } else {
            const toolsFolder = getShortcutDetail(@anchorEntity, "Folder")
            rawAction("com.apple.shortcuts.MoveShortcutToFolderAction", {
                "shortcuts": "${@selfEntity}",
                "folder": "${toolsFolder}"
            })
            @result = "ok bootstrapped shortcuts.control beside probe.echo"
        }
    }
}

if @op == "list" {
    @handled = "true"
    const allShortcuts = getShortcuts()
    const shortcutNames = getText(allShortcuts)
    @result = "{shortcutNames}"
}

if @op == "get" {
    @handled = "true"
    if !@name {
        @state = "error"
        @result = "error missing_name"
    } else {
        @found = "false"
        const all = getShortcuts()
        for candidate in all {
            const candidateName = getShortcutDetail(@candidate, "Name")
            @candidateNameText = "{candidateName}"
            if @candidateNameText == "{@name}" {
                @found = "true"
                const candidateFolder = getShortcutDetail(@candidate, "Folder")
                const candidateActions = getShortcutDetail(@candidate, "Action Count")
                const candidateSize = getShortcutDetail(@candidate, "File Size")
                @result = "name={candidateName}\nfolder={candidateFolder}\naction_count={candidateActions}\nfile_size={candidateSize}"
            }
        }
        if @found == "false" {
            @state = "error"
            @result = "error not_found"
        }
    }
}

if @op == "run" {
    @handled = "true"
    if !@name {
        @state = "error"
        @result = "error missing_name"
    } else {
        const runResult = run(@name, @runInput)
        @result = "{runResult}"
    }
}

if @op == "create" {
    @handled = "true"
    if !@name {
        @state = "error"
        @result = "error missing_name"
    } else {
        rawAction("com.apple.shortcuts.CreateWorkflowAction", {
            "name": "${@name}",
            "OpenWhenRun": false
        })
        @result = "ok created {@name}"
    }
}

if @op == "open" {
    @handled = "true"
    if !@name {
        @state = "error"
        @result = "error missing_name"
    } else {
        rawAction("com.apple.shortcuts.OpenWorkflowAction", {
            "target": {
                "title": "${@name}"
            }
        })
        @result = "ok opened {@name}"
    }
}

if @op == "create_folder" {
    @handled = "true"
    if !@folder {
        @state = "error"
        @result = "error missing_folder"
    } else {
        rawAction("com.apple.shortcuts.CreateFolderAction", {
            "name": "${@folder}",
            "OpenWhenRun": false
        })
        @result = "ok folder_created {@folder}"
    }
}

if @op == "move_new_folder" {
    @handled = "true"
    if !@name {
        @state = "error"
        @result = "error missing_name"
    } else {
        if !@folder {
            @state = "error"
            @result = "error missing_folder"
        } else {
            @foundMoveSource = "false"
            const moveEntities = getShortcuts()
            for moveEntity in moveEntities {
                const moveName = getShortcutDetail(@moveEntity, "Name")
                @moveNameText = "{moveName}"
                if @moveNameText == "{@name}" {
                    @foundMoveSource = "true"
                    const createdFolder = rawAction("com.apple.shortcuts.CreateFolderAction", {
                        "name": "${@folder}",
                        "OpenWhenRun": false
                    })
                    rawAction("com.apple.shortcuts.MoveShortcutToFolderAction", {
                        "shortcuts": "${@moveEntity}",
                        "folder": "${createdFolder}"
                    })
                    @result = "ok moved {@name} -> new_folder {@folder}"
                }
            }
            if @foundMoveSource == "false" {
                @state = "error"
                @result = "error not_found"
            }
        }
    }
}

if @op == "rename" || @op == "delete" || @op == "create_link" {
    @handled = "true"

    if !@name {
        @state = "error"
        @result = "error missing_name"
    } else {
        if @op == "delete" && @confirm != "true" {
            @state = "error"
            @result = "error confirmation_required"
        } else {
            @foundEntity = "false"
            const entities = getShortcuts()

            for entity in entities {
                const entityName = getShortcutDetail(@entity, "Name")
                @entityNameText = "{entityName}"

                if @entityNameText == "{@name}" {
                    @foundEntity = "true"

                    if @op == "rename" {
                        if !@newName {
                            @state = "error"
                            @result = "error missing_new_name"
                        } else {
                            rawAction("com.apple.shortcuts.RenameShortcutAction", {
                                "shortcut": "${@entity}",
                                "name": "${@newName}",
                                "OpenWhenRun": false
                            })
                            @result = "ok renamed {@name} -> {@newName}"
                        }
                    }

                    if @op == "create_link" {
                        const link = createShortcutLink(@entity)
                        @result = "{link}"
                    }

                    if @op == "delete" {
                        rawAction("com.apple.shortcuts.DeleteWorkflowAction", {
                            "entities": "${@entity}"
                        })
                        @result = "ok deleted {@name}"
                    }
                }
            }

            if @foundEntity == "false" {
                @state = "error"
                @result = "error not_found"
            }
        }
    }
}

if @handled == "false" {
    @state = "error"
    @result = "error unsupported_operation"
}

if @callback {
    jsonRequest(@callback, "POST", {
        "state": "{@state}",
        "result": "{@result}"
    })
}

output("{@result}")
