#define name harness.shortcuts.control
#define color blue
#define glyph wrench
#define inputs text
#define outputs text
#define version 27

#include 'actions/shortcuts'
#include 'actions/web'
#include 'actions/documents'
#include 'actions/text'

comment('harness.shortcuts.control v0.1 — resident agent control plane.')
comment('JSON input selects a native local operation. If callback is supplied, the controller POSTs the real device result back to the harness.')
comment('Compiler/signing remains the content-authoring plane; install/edit stage a signed artifact and leave final import confirmation to Apple.')

const request = getDictionary(ShortcutInput)

@op = "{request['op']}"
@name = "{request['name']}"
@newName = "{request['new_name']}"
@runInput = "{request['input']}"
@confirm = "{request['confirm']}"
@folder = "{request['folder']}"
@url = "{request['url']}"
@filename = "{request['filename']}"
@callback = "{request['callback']}"

@handled = "false"
@state = "success"
@result = ""

if @op == "ping" {
    @handled = "true"
    @result = "ok ping harness.shortcuts.control 0.1"
}

if @op == "capabilities" {
    @handled = "true"
    @result = "ping\ncapabilities\nlist\nget\nrun\ncreate\nopen\ncreate_folder\nrename\ndelete\ncreate_link\nstage\ninstall\nedit"
}

if @op == "list" {
    @handled = "true"
    const allShortcuts = getShortcuts()
    const shortcutNames = getText(allShortcuts)
    @result = "{shortcutNames}"
}

if @op == "get" {
    @handled = "true"
    if !@name {
        @state = "error"
        @result = "error missing_name"
    } else {
        @found = "false"
        const all = getShortcuts()
        for candidate in all {
            const candidateName = getShortcutDetail(@candidate, "Name")
            @candidateNameText = "{candidateName}"
            if @candidateNameText == "{@name}" {
                @found = "true"
                const candidateFolder = getShortcutDetail(@candidate, "Folder")
                const candidateActions = getShortcutDetail(@candidate, "Action Count")
                const candidateSize = getShortcutDetail(@candidate, "File Size")
                @result = "name={candidateName}\nfolder={candidateFolder}\naction_count={candidateActions}\nfile_size={candidateSize}"
            }
        }
        if @found == "false" {
            @state = "error"
            @result = "error not_found"
        }
    }
}

if @op == "run" {
    @handled = "true"
    if !@name {
        @state = "error"
        @result = "error missing_name"
    } else {
        const runResult = run(@name, @runInput)
        @result = "{runResult}"
    }
}

if @op == "create" {
    @handled = "true"
    if !@name {
        @state = "error"
        @result = "error missing_name"
    } else {
        rawAction("com.apple.shortcuts.CreateWorkflowAction", {
            "name": "${@name}",
            "OpenWhenRun": false
        })
        @result = "ok created {@name}"
    }
}

if @op == "open" {
    @handled = "true"
    if !@name {
        @state = "error"
        @result = "error missing_name"
    } else {
        rawAction("com.apple.shortcuts.OpenWorkflowAction", {
            "target": {
                "title": "${@name}"
            }
        })
        @result = "ok opened {@name}"
    }
}

if @op == "create_folder" {
    @handled = "true"
    if !@folder {
        @state = "error"
        @result = "error missing_folder"
    } else {
        rawAction("com.apple.shortcuts.CreateFolderAction", {
            "name": "${@folder}",
            "OpenWhenRun": false
        })
        @result = "ok folder_created {@folder}"
    }
}

if @op == "rename" || @op == "delete" || @op == "create_link" {
    @handled = "true"

    if !@name {
        @state = "error"
        @result = "error missing_name"
    } else {
        if @op == "delete" && @confirm != "true" {
            @state = "error"
            @result = "error confirmation_required"
        } else {
            @foundEntity = "false"
            const entities = getShortcuts()

            for candidate in entities {
                const candidateName = getShortcutDetail(@candidate, "Name")
                @candidateNameText = "{candidateName}"

                if @candidateNameText == "{@name}" {
                    @foundEntity = "true"

                    if @op == "rename" {
                        if !@newName {
                            @state = "error"
                            @result = "error missing_new_name"
                        } else {
                            rawAction("com.apple.shortcuts.RenameShortcutAction", {
                                "shortcut": "${@candidate}",
                                "name": "${@newName}",
                                "OpenWhenRun": false
                            })
                            @result = "ok renamed {@name} -> {@newName}"
                        }
                    }

                    if @op == "create_link" {
                        const link = createShortcutLink(@candidate)
                        @result = "{link}"
                    }

                    if @op == "delete" {
                        rawAction("com.apple.shortcuts.DeleteWorkflowAction", {
                            "entities": "${@candidate}"
                        })
                        @result = "ok deleted {@name}"
                    }
                }
            }

            if @foundEntity == "false" {
                @state = "error"
                @result = "error not_found"
            }
        }
    }
}

if @op == "stage" || @op == "install" || @op == "edit" {
    @handled = "true"

    if !@url {
        @state = "error"
        @result = "error missing_url"
    } else {
        if !@filename {
            @filename = "harness-staged.shortcut"
        }

        const downloaded = downloadURL(@url)

        rawAction("is.workflow.actions.documentpicker.save", {
            "WFFileDestinationPath": "{@filename}",
            "WFInput": "${downloaded}",
            "WFSaveFileOverwrite": true,
            "WFAskWhereToSave": false
        })

        const staged = getFile("{@filename}")
        rawAction("is.workflow.actions.openin", {
            "WFInput": "${staged}",
            "WFOpenInAskWhenRun": false
        })

        @result = "ok opened_import {@filename}"
    }
}

if @handled == "false" {
    @state = "error"
    @result = "error unsupported_operation"
}

if @callback {
    jsonRequest(@callback, "POST", {
        "state": "{@state}",
        "result": "{@result}"
    })
}

output("{@result}")
