#define name harness.shortcuts.library
#define color blue
#define glyph wrench
#define inputs text
#define outputs text
#define version 27

#include 'actions/shortcuts'

comment('harness.shortcuts.library v0.3 — pure Apple-native persistent Shortcut library management.')
comment('Input is a JSON dictionary with op plus operation parameters. No shell, network, model, or UI automation actions are used.')
comment('Destructive delete requires confirm=true. Content editing/install remains a separate artifact/compiler plane.')

const request = getDictionary(ShortcutInput)
@op = "{request['op']}"
@name = "{request['name']}"
@newName = "{request['new_name']}"
@runInput = "{request['input']}"
@confirm = "{request['confirm']}"
@folder = "{request['folder']}"

comment('Return the static capability contract.')
if @op == "capabilities" {
    output('{"ok":true,"op":"capabilities","controller_version":"0.3","operations":["capabilities","list","create","run","open","create_folder","rename","delete","create_link"]}')
}

comment('List native Shortcut objects. The external control plane may normalize attributes.')
if @op == "list" {
    const allShortcuts = getShortcuts()
    rawAction("is.workflow.actions.output", {
        "WFOutput": "${allShortcuts}"
    })
}

comment('Create a persistent empty Shortcut object. Content installation belongs to the artifact plane.')
if @op == "create" {
    if !@name {
        output('{"ok":false,"op":"create","error":"missing_name"}')
    }
    rawAction("com.apple.shortcuts.CreateWorkflowAction", {
        "name": "${@name}",
        "OpenWhenRun": false
    })
    output('{"ok":true,"op":"create","status":"created"}')
}

comment('Run an already installed Shortcut by exact name using the stable Run Shortcut action.')
if @op == "run" {
    if !@name {
        output('{"ok":false,"op":"run","error":"missing_name"}')
    }
    const runResult = run(@name, @runInput)
    rawAction("is.workflow.actions.output", {
        "WFOutput": "${runResult}"
    })
}

comment('Open an already installed Shortcut by name.')
if @op == "open" {
    if !@name {
        output('{"ok":false,"op":"open","error":"missing_name"}')
    }
    rawAction("com.apple.shortcuts.OpenWorkflowAction", {
        "target": {
            "title": "${@name}"
        }
    })
    output('{"ok":true,"op":"open","status":"launched"}')
}

comment('Create a native Shortcuts folder.')
if @op == "create_folder" {
    if !@folder {
        output('{"ok":false,"op":"create_folder","error":"missing_folder"}')
    }
    rawAction("com.apple.shortcuts.CreateFolderAction", {
        "name": "${@folder}",
        "OpenWhenRun": false
    })
    output('{"ok":true,"op":"create_folder","status":"created"}')
}

comment('For entity-bearing operations, scan the library and act on the first exact-name match. Agent-managed names should be unique.')
if @op == "rename" || @op == "create_link" || @op == "delete" {
    if !@name {
        output('{"ok":false,"error":"missing_name"}')
    }
    if @op == "delete" && @confirm != "true" {
        output('{"ok":false,"op":"delete","error":"confirmation_required"}')
    }

    const all = getShortcuts()
    for candidate in all {
        const candidateName = getShortcutDetail(@candidate, "Name")
        @candidateNameText = "{candidateName}"

        if @candidateNameText == "{@name}" {
            if @op == "rename" {
                if !@newName {
                    output('{"ok":false,"op":"rename","error":"missing_new_name"}')
                }
                rawAction("com.apple.shortcuts.RenameShortcutAction", {
                    "shortcut": "${@candidate}",
                    "name": "${@newName}",
                    "OpenWhenRun": false
                })
                output('{"ok":true,"op":"rename","status":"updated"}')
            }

            if @op == "create_link" {
                const link = createShortcutLink(@candidate)
                rawAction("is.workflow.actions.output", {
                    "WFOutput": "${link}"
                })
            }

            if @op == "delete" {
                rawAction("com.apple.shortcuts.DeleteWorkflowAction", {
                    "entities": "${@candidate}"
                })
                output('{"ok":true,"op":"delete","status":"deleted"}')
            }
        }
    }
    output('{"ok":false,"error":"not_found"}')
}

comment('Reject content-plane or unknown operations instead of approximating with UI automation.')
if @op == "edit" || @op == "duplicate" || @op == "install" || @op == "export" {
    output('{"ok":false,"error":"unsupported_content_operation","message":"Use the desktop artifact/compiler backend."}')
}

output('{"ok":false,"error":"unsupported_operation"}')
