#define name harness.shortcuts.stage
#define color blue
#define glyph folder
#define inputs text
#define outputs text
#define version 27

#include 'actions/web'
#include 'actions/documents'

comment('harness.shortcuts.stage v0.1 — stage a signed .shortcut artifact for native import.')
comment('Input JSON: {"url":"https://...","filename":"name.shortcut"}.')
comment('Downloads and saves the file, then opens it. Apple still owns the Add Shortcut confirmation.')

const request = getDictionary(ShortcutInput)
@url = "{request['url']}"
@filename = "{request['filename']}"

if !@url {
    output('{"ok":false,"error":"missing_url"}')
}

if !@filename {
    @filename = "harness-staged.shortcut"
}

const downloaded = downloadURL(@url)
const saved = saveFile("{@filename}", @downloaded, true)
openFile(@saved, false)
output('{"ok":true,"status":"opened_import","filename":"{@filename}"}')
