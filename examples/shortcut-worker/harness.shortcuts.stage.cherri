#define name harness.shortcuts.stage
#define color blue
#define glyph folder
#define inputs text
#define outputs text
#define version 27

#include 'actions/web'
#include 'actions/documents'

comment('harness.shortcuts.stage v0.2 — content-plane handoff for a signed .shortcut artifact.')
comment('Input JSON: url, filename, optional callback. Downloads and saves the file, posts staged receipt, then opens Apple native import.')

const request = getDictionary(ShortcutInput)
@url = "{request['url']}"
@filename = "{request['filename']}"
@callback = "{request['callback']}"

if !@url {
    if @callback {
        jsonRequest(@callback, "POST", {
            "state": "error",
            "result": "error missing_url"
        })
    }
    output("error missing_url")
}

if !@filename {
    @filename = "harness-staged.shortcut"
}

const downloaded = downloadURL(@url)

rawAction("is.workflow.actions.documentpicker.save", {
    "WFFileDestinationPath": "{@filename}",
    "WFInput": "${downloaded}",
    "WFSaveFileOverwrite": true,
    "WFAskWhereToSave": false
})

if @callback {
    jsonRequest(@callback, "POST", {
        "state": "success",
        "result": "ok staged {@filename}; opening native import"
    })
}

const staged = getFile("{@filename}")
rawAction("is.workflow.actions.openin", {
    "WFInput": "${staged}",
    "WFOpenInAskWhenRun": false
})

output("ok opened_import {@filename}")
