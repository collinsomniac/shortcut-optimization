{
  "protocol": "shortcut-worker/0.5-live",
  "persistence_model": {
    "canonical_folder": "harness.shortcuts",
    "generated_folder": "Agent Generated",
    "identity": "project-side shortcut_ref + native name + latest artifact/content hash",
    "idempotency": "ensure operations reuse an existing matching installed object instead of regenerating it",
    "mutation_conflict_policy": "expected_version/hash required when available"
  },
  "transport": {
    "job_facade": "private.shortcut_call(op, params, ttl)",
    "controller_update_facade": "private.shortcut_install_controller(ttl)",
    "worker": "iphone-main",
    "dispatch_method": "shortcuts.control",
    "handoff_method": "shortcuts.open_url",
    "wake": "Pushcut notification automation -> RPC Worker Harness",
    "status": "device_verified_zero_touch",
    "note": "Agents should normally call the private shortcut facade rather than raw rpc_submit. a-Shell is not on the Shortcuts critical path."
  },
  "methods": {
    "shortcuts.capabilities": {
      "effect": "read",
      "backend": [
        "native_catalog",
        "worker"
      ],
      "lifecycle": "persistent"
    },
    "shortcuts.inventory.list": {
      "effect": "read",
      "backend": [
        "Get My Shortcuts"
      ],
      "lifecycle": "persistent",
      "status": "device_verified"
    },
    "shortcuts.ensure": {
      "effect": "reversible_write",
      "backend": [
        "inventory",
        "create",
        "generate",
        "edit"
      ],
      "semantics": "Create once or reconcile to requested spec; reuse when already current."
    },
    "shortcuts.create": {
      "effect": "reversible_write",
      "backend": [
        "Create Shortcut"
      ],
      "lifecycle": "persistent",
      "note": "Create Shortcut creates a persistent empty/native Shortcut shell by name; it is not a general arbitrary action-graph installer.",
      "status": "typed_fix_v08_pending_device_acceptance"
    },
    "shortcuts.generate": {
      "effect": "reversible_write",
      "backend": [
        "desktop_cherri_compiler",
        "native Describe a Shortcut fallback"
      ],
      "lifecycle": "persistent",
      "note": "Imported GenerateShortcutAction bootstrap was rejected by the target iPhone as unsupported; do not use as primary path."
    },
    "shortcuts.get": {
      "effect": "read",
      "backend": [
        "inventory",
        "artifact compiler"
      ],
      "status": "route_verified"
    },
    "shortcuts.snapshot": {
      "effect": "read",
      "backend": [
        "export",
        "artifact store"
      ],
      "result": "versioned artifact hash"
    },
    "shortcuts.diff": {
      "effect": "read",
      "backend": [
        "compiler"
      ]
    },
    "shortcuts.edit": {
      "effect": "reversible_write",
      "backend": [
        "desktop artifact patch/compiler",
        "native builder fallback",
        "action pasteboard experimental"
      ],
      "note": "Action-pasteboard route is deprioritized because it remains editor/UI-bound and was not reproduced on the target device."
    },
    "shortcuts.duplicate": {
      "effect": "reversible_write",
      "backend": [
        "artifact_clone",
        "action_pasteboard_clone",
        "UI fallback"
      ],
      "native_dedicated_action": false
    },
    "shortcuts.run": {
      "effect": "runtime",
      "backend": [
        "Run Shortcut",
        "Pushcut"
      ],
      "verify_receipt": true,
      "status": "device_verified_input_output"
    },
    "shortcuts.open": {
      "effect": "ui_handoff",
      "backend": [
        "Open Shortcut"
      ]
    },
    "shortcuts.rename": {
      "effect": "reversible_write",
      "backend": [
        "Rename Shortcut"
      ],
      "status": "typed_fix_v08_pending_device_acceptance"
    },
    "shortcuts.move": {
      "effect": "reversible_write",
      "backend": [
        "Move Shortcut"
      ],
      "status": "typed_fix_v08_pending_device_acceptance"
    },
    "shortcuts.folder.create": {
      "effect": "reversible_write",
      "backend": [
        "Create Folder"
      ],
      "status": "typed_fix_v08_pending_device_acceptance"
    },
    "shortcuts.folder.open": {
      "effect": "ui_handoff",
      "backend": [
        "Open Folder"
      ]
    },
    "shortcuts.attributes.get": {
      "effect": "read",
      "backend": [
        "Get Shortcut Attributes"
      ]
    },
    "shortcuts.attributes.set": {
      "effect": "reversible_write",
      "backend": [
        "Set Shortcut Attributes"
      ]
    },
    "shortcuts.icon.set": {
      "effect": "reversible_write",
      "backend": [
        "Change Shortcut Icon"
      ]
    },
    "shortcuts.share.create_link": {
      "effect": "external_share",
      "backend": [
        "Create iCloud Link for Shortcut"
      ]
    },
    "shortcuts.export": {
      "effect": "read",
      "backend": [
        "native export",
        "artifact compiler"
      ],
      "status": "backend_under_validation"
    },
    "shortcuts.install": {
      "effect": "reversible_write",
      "backend": [
        "signed artifact",
        "private.shortcut_install_controller",
        "Apple native import confirmation"
      ],
      "status": "native_handoff_verified_confirmation_required",
      "note": "Public iOS import remains user-confirmed; do not claim silent install into the Shortcuts database."
    },
    "shortcuts.delete": {
      "effect": "destructive",
      "backend": [
        "Delete Shortcuts"
      ],
      "requires": "confirm=true and device-verified controller implementation",
      "status": "hold_unverified_entity_serialization"
    },
    "shortcuts.export_to_worker": {
      "effect": "read",
      "backend": [
        "optional a-Shell Put File adapter"
      ],
      "semantics": "Optional adapter for copying an explicitly selected native Shortcut object into a-Shell's App Group for inspection/versioning.",
      "status": "optional_not_core_not_device_verified",
      "note": "Removed from pure-native harness.shortcuts.library v0.3. Heavy artifact work belongs on desktop-main."
    },
    "shortcuts.dispatch": {
      "effect": "runtime",
      "backend": [
        "RPC Worker Harness -> shortcuts.control"
      ],
      "semantics": "Parameterized execution of an already-installed Shortcut by exact name with optional input; no generation/signing per run.",
      "status": "superseded_by_shortcuts.control"
    },
    "shortcuts.stage": {
      "effect": "ui_handoff",
      "backend": [
        "harness.shortcuts.stage"
      ],
      "semantics": "Download a signed .shortcut artifact on-device, save it into the Shortcuts/Files container, and open it for Apple's native Add Shortcut confirmation.",
      "status": "compatibility_only"
    }
  },
  "result_statuses": [
    "proposed",
    "reused",
    "drafted",
    "installed",
    "registered",
    "launched",
    "executed",
    "verified",
    "updated",
    "shared",
    "deleted",
    "confirmation_required",
    "conflict",
    "unsupported",
    "failed",
    "cancelled"
  ],
  "live_controller": {
    "installed_version": "0.5",
    "available_version": "0.8",
    "stable_artifact_url": "https://zpdtlzpvshlpyqbfbzye.supabase.co/functions/v1/shortcut-bootstrap",
    "available_artifact_sha256": "5128c52f0633df61102d5aa6f805a97629bf02c9c5954b1f16340730556b411e",
    "verified": [
      "ping",
      "list",
      "run"
    ],
    "route_verified": [
      "get"
    ],
    "pending_v08_acceptance": [
      "create",
      "rename",
      "create_folder",
      "move_new_folder"
    ],
    "hold_until_verified": [
      "delete"
    ],
    "compatibility_only": [
      "harness.shortcuts.library",
      "harness.shortcuts.stage",
      "harness.shortcuts.run"
    ]
  }
}
