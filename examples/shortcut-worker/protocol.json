{
  "protocol": "shortcut-worker/0.3-draft",
  "persistence_model": {
    "canonical_folder": "harness.shortcuts",
    "generated_folder": "Agent Generated",
    "identity": "project-side shortcut_ref + native name + latest artifact/content hash",
    "idempotency": "ensure operations reuse an existing matching installed object instead of regenerating it",
    "mutation_conflict_policy": "expected_version/hash required when available"
  },
  "transport": {
    "job_facade": "public.submit_shortcut_job(operation, params, ttl)",
    "worker": "iphone-main",
    "dispatch_method": "shortcuts.control",
    "current_live_note": "The semantic protocol is ahead of the live phone dispatcher. Do not claim a method is routable until device verification succeeds."
  },
  "methods": {
    "shortcuts.capabilities": {
      "effect": "read",
      "backend": [
        "native_catalog",
        "worker"
      ],
      "lifecycle": "persistent"
    },
    "shortcuts.inventory.list": {
      "effect": "read",
      "backend": [
        "Get My Shortcuts"
      ],
      "lifecycle": "persistent"
    },
    "shortcuts.ensure": {
      "effect": "reversible_write",
      "backend": [
        "inventory",
        "create",
        "generate",
        "edit"
      ],
      "semantics": "Create once or reconcile to requested spec; reuse when already current."
    },
    "shortcuts.create": {
      "effect": "reversible_write",
      "backend": [
        "Create Shortcut"
      ],
      "lifecycle": "persistent"
    },
    "shortcuts.generate": {
      "effect": "reversible_write",
      "backend": [
        "GenerateShortcutAction",
        "Describe a Shortcut",
        "compiler"
      ],
      "lifecycle": "persistent"
    },
    "shortcuts.get": {
      "effect": "read",
      "backend": [
        "inventory",
        "artifact compiler"
      ]
    },
    "shortcuts.snapshot": {
      "effect": "read",
      "backend": [
        "export",
        "artifact store"
      ],
      "result": "versioned artifact hash"
    },
    "shortcuts.diff": {
      "effect": "read",
      "backend": [
        "compiler"
      ]
    },
    "shortcuts.edit": {
      "effect": "reversible_write",
      "backend": [
        "artifact patch",
        "action pasteboard",
        "native builder fallback"
      ]
    },
    "shortcuts.duplicate": {
      "effect": "reversible_write",
      "backend": [
        "artifact_clone",
        "action_pasteboard_clone",
        "UI fallback"
      ],
      "native_dedicated_action": false
    },
    "shortcuts.run": {
      "effect": "runtime",
      "backend": [
        "Run Shortcut",
        "Pushcut"
      ],
      "verify_receipt": true
    },
    "shortcuts.open": {
      "effect": "ui_handoff",
      "backend": [
        "Open Shortcut"
      ]
    },
    "shortcuts.rename": {
      "effect": "reversible_write",
      "backend": [
        "Rename Shortcut"
      ]
    },
    "shortcuts.move": {
      "effect": "reversible_write",
      "backend": [
        "Move Shortcut"
      ]
    },
    "shortcuts.folder.create": {
      "effect": "reversible_write",
      "backend": [
        "Create Folder"
      ]
    },
    "shortcuts.folder.open": {
      "effect": "ui_handoff",
      "backend": [
        "Open Folder"
      ]
    },
    "shortcuts.attributes.get": {
      "effect": "read",
      "backend": [
        "Get Shortcut Attributes"
      ]
    },
    "shortcuts.attributes.set": {
      "effect": "reversible_write",
      "backend": [
        "Set Shortcut Attributes"
      ]
    },
    "shortcuts.icon.set": {
      "effect": "reversible_write",
      "backend": [
        "Change Shortcut Icon"
      ]
    },
    "shortcuts.share.create_link": {
      "effect": "external_share",
      "backend": [
        "Create iCloud Link for Shortcut"
      ]
    },
    "shortcuts.export": {
      "effect": "read",
      "backend": [
        "native export",
        "artifact compiler"
      ],
      "status": "backend_under_validation"
    },
    "shortcuts.install": {
      "effect": "reversible_write",
      "backend": [
        "trusted signed import",
        "action pasteboard"
      ],
      "status": "backend_under_validation"
    },
    "shortcuts.delete": {
      "effect": "destructive",
      "backend": [
        "Delete Shortcuts"
      ],
      "requires": "confirm=true"
    },
    "shortcuts.export_to_worker": {
      "effect": "read",
      "backend": [
        "Get My Shortcuts",
        "a-Shell Put File"
      ],
      "semantics": "Resolve exact installed Shortcut and copy its native file representation into the a-Shell worker sandbox for inspection/versioning.",
      "status": "compiled_not_device_verified"
    }
  },
  "result_statuses": [
    "proposed",
    "reused",
    "drafted",
    "installed",
    "registered",
    "launched",
    "executed",
    "verified",
    "updated",
    "shared",
    "deleted",
    "confirmation_required",
    "conflict",
    "unsupported",
    "failed",
    "cancelled"
  ]
}
